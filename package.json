{
  "name": "agencia-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared/contracts",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "db:up": "docker compose -f ops/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f ops/docker-compose.yml down",
    "migrate": "npm run migrate -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck --workspaces"
  }
}
