# Plantilla de producción. Copiar a ~/infra/kora/.env (chmod 600) y rellenar. NUNCA subir el .env real.
# Generar secretos: openssl rand -hex 32  (JWT, passphrase)  ·  openssl rand -base64 24 | tr -d '/+=' (contraseñas)

# --- General ---
NODE_ENV=production
KORA_IMAGE=kora:local
TUNNEL_NETWORK=n8n_default
APP_URL=https://app.TU-DOMINIO.com
# Host de la landing estática (la API distingue por Host). Vacío = sin landing.
LANDING_HOST=TU-DOMINIO.com

# --- Base de datos ---
PG_PASSWORD=
APP_DB_PASSWORD=
# DATABASE_URL, DATABASE_URL_APP y S3_ENDPOINT los compone compose.prod.yml con estas contraseñas.

# --- Archivos (MinIO) ---
S3_ACCESS_KEY=kora
S3_SECRET_KEY=
S3_BUCKET=agencia-hub
# MinIO retiró sus imágenes públicas de Docker Hub (oct 2025): si no se puede descargar, fijar aquí una imagen
# alternativa o una ya presente en el servidor (p. ej. MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z).
# MINIO_IMAGE=minio/minio:latest
# MC_IMAGE=minio/mc

# --- Email (Brevo por defecto: smtp://LOGIN:CLAVE@smtp-relay.brevo.com:587) ---
SMTP_URL=
MAIL_FROM="Kora <no-reply@TU-DOMINIO.com>"

# --- Sesiones y push ---
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@TU-DOMINIO.com

# --- Stripe (vacío = facturación simulada) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
PRICE_STANDARD_CENTS=600
PRICE_PRO_CENTS=900

# --- Alertas y backups ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_PASSPHRASE=
BACKUP_DIR=/home/USUARIO/infra/kora/backups
