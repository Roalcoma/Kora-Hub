# Copiar a .env y ajustar. Nunca subir .env al repo.

# API
PORT=4300
APP_URL=http://localhost:5180

# Dueño del esquema: migraciones y operaciones de plataforma (adminPool, sin RLS)
DATABASE_URL=postgres://agencia:agencia_dev@localhost:55432/agencia_hub
# Rol de la app (appPool, con RLS)
DATABASE_URL_APP=postgres://agencia_app:agencia_app_dev@localhost:55432/agencia_hub

# Archivos (MinIO / S3)
S3_ENDPOINT=http://localhost:59000
S3_BUCKET=agencia-hub
S3_ACCESS_KEY=agencia
S3_SECRET_KEY=agencia_dev_secret

# Email (Mailpit en local)
SMTP_URL=smtp://localhost:51025
MAIL_FROM="Kora <no-reply@kora.local>"

# Sesiones
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@agencia-hub.local

# Facturación (Stripe por REST). Con STRIPE_SECRET_KEY vacío: simulada en desarrollo, manual en producción
# (salvo BILLING_SIMULATED=true). Ver ADR 0005.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Ids de precio de Stripe (price_...) de cada plan
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
# Precio por puesto que muestra la UI, en centavos de USD (por defecto 600 y 900)
PRICE_STANDARD_CENTS=600
PRICE_PRO_CENTS=900

# Servir la web compilada desde la API (en producción lo fija el Dockerfile; en local déjalo vacío)
WEB_DIST=
# Landing estática: carpeta y host por el que se sirve (p. ej. kora.example.com). Ambos vacíos = sin landing
LANDING_DIR=
LANDING_HOST=

# Alertas a Telegram (5xx, jobs fallidos, webhooks rechazados); vacío = sin alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ventas desde Discord (docs/plan-comisiones.md): token del bot con permiso de leer el canal de ventas y
# el "Message Content Intent" activado. Sin token no se lee Discord; el canal se elige en Ventas → Configuración.
DISCORD_BOT_TOKEN=

# Registro público de agencias (POST /auth/register). Por defecto abierto (dev, pruebas, demo). En producción va en
# false: solo se entra con un enlace de invitación (aceptar invitaciones sigue funcionando).
REGISTRATION_OPEN=true

# Aviso del respaldo diario (franja arriba en la app). Hora de inicio en UTC "HH:MM" (vacío = sin aviso), duración de la
# ventana y cuántos minutos antes se avisa. 06:00 UTC = 2:00 a. m. en Venezuela (America/Caracas, UTC-4 fijo).
MAINTENANCE_DAILY_UTC=
MAINTENANCE_MINUTES=15
MAINTENANCE_NOTICE_MINUTES=30

# Solo producción: frase para cifrar backups (ops/backup.sh) y carpeta destino. Ver docs/despliegue.md
# BACKUP_PASSPHRASE=
# BACKUP_DIR=

# Botón "Rocco CRM" en la barra lateral (login de la otra app de Árbol Áureo). El superadmin decide en /admin qué
# agencias lo ven. Debe ser https (http solo en desarrollo). Vacío = https://rocco.arbolaureo.org
CRM_URL=https://rocco.arbolaureo.org
# Visor de Office (OnlyOffice / Euro-Office, solo lectura). URL base pública del servidor de oficina y su JWT_SECRET.
# Vacías → la web usa su visor propio de Excel/Word. Hoy: el Euro-Office de Nextcloud AIO (https://cloud.arbolaureo.org/eurooffice).
OFFICE_URL=
OFFICE_JWT_SECRET=
